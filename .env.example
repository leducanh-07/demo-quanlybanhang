# Database connection settings (MySQL 8.0.16+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fishball_cart

# SSL Configuration for cloud databases (e.g. Aiven, AWS RDS, PlanetScale)
# Set DB_SSL=true to enable SSL connection
DB_SSL=false
# Only set false to connect without a trusted CA certificate.
DB_SSL_REJECT_UNAUTHORIZED=true
# Option 1: File path relative to project root (e.g. certs/aiven-ca.pem)
DB_SSL_CA_FILE=
# Option 2: Full PEM certificate content (recommended for Render dashboard)
DB_SSL_CA=

# Session secret for JWT signing (at least 32 characters)
SESSION_SECRET=

# Session cookie name
COOKIE_NAME=fishball_session

# Default accounts created or updated by the seed scripts
DEFAULT_OWNER_USERNAME=owner
DEFAULT_OWNER_PASSWORD=
DEFAULT_MANAGER_USERNAME=manager
DEFAULT_MANAGER_PASSWORD=
