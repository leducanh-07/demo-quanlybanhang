# Database connection settings (MySQL 8.0.16+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fishball_cart

# SSL Configuration for cloud databases (e.g. Aiven, AWS RDS, PlanetScale)
# Set DB_SSL=true to enable SSL connection
DB_SSL=false
# Option 1: File path relative to project root (e.g. certs/aiven-ca.pem)
DB_SSL_CA_FILE=
# Option 2: Full PEM certificate content (recommended for Render dashboard)
DB_SSL_CA=

# Session secret for JWT signing (at least 32 characters)
SESSION_SECRET=

# Seed passwords for initial setup (at least 12 characters recommended)
SEED_OWNER_PASSWORD=
SEED_STATION_PASSWORD=
